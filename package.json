{
  "name": "devforge",
  "version": "0.1.0-beta",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "turbo run build",
    "build:release": "powershell ./scripts/build-release.ps1",
    "verify": "powershell ./scripts/verify-publish.ps1",
    "publish:beta": "powershell ./scripts/publish.ps1",
    "publish:dry-run": "pnpm publish --dry-run",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "turbo": "^1.13.4",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.0",
    "eslint": "^8.0.0"
  }
}
